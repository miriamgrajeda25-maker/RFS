    <!-- JavaScript Application Logic -->
    <script>
        const TICKET_PRICE = 10; // $10 MXN per ticket
        const TOTAL_TICKETS = 4000; // 000 to 3999
        let selectedTickets = new Set();
        
        // Map to store assigned extra opportunities for each main ticket
        // Key: Main ticket number (e.g. '042'), Value: Array of 2 extra random numbers [ '128', '654' ]
        const ticketExtraMap = new Map();

        // Mock Occupied Tickets Pool (simulating sold tickets out of 4000)
        const takenTickets = new Set(['005', '012', '028', '045', '089', '150', '230', '312', '450', '521', '600', '710']);

        // Window Load Initialization
        window.addEventListener('DOMContentLoaded', () => {
            renderGrid();
            startCountdown();
        });

        // Generate 2 unique random extra numbers for a given main ticket
        function getOrGenerateExtraNumbers(mainNum) {
            if (ticketExtraMap.has(mainNum)) {
                return ticketExtraMap.get(mainNum);
            }

            const extras = [];
            while (extras.length < 2) {
                const randInt = Math.floor(Math.random() * TOTAL_TICKETS);
                const formatted = String(randInt).padStart(3, '0');
                if (formatted !== mainNum && !extras.includes(formatted)) {
                    extras.push(formatted);
                }
            }

            ticketExtraMap.set(mainNum, extras);
            return extras;
        }

        // Render Grid of 4000 Tickets (000 to 3999)
        function renderGrid() {
            const gridContainer = document.getElementById('ticketGrid');
            gridContainer.innerHTML = '';

            for (let i = 0; i < TOTAL_TICKETS; i++) {
                const ticketNum = String(i).padStart(3, '0');
                const isTaken = takenTickets.has(ticketNum);
                const isSelected = selectedTickets.has(ticketNum);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = ticketNum;

                let classes = "py-2.5 text-xs font-bold rounded-xl transition-all duration-200 border font-mono ";
                
                if (isTaken) {
                    classes += "bg-red-950/40 border-red-900/60 text-red-700 cursor-not-allowed opacity-60";
                    btn.disabled = true;
                } else if (isSelected) {
                    classes += "bg-cashGreen-500 border-cashGreen-400 text-darkNavy shadow-lg scale-105 font-black";
                    btn.onclick = () => toggleTicket(ticketNum);
                } else {
                    classes += "bg-darkNavy border-gray-800 text-gray-300 hover:border-cashGreen-500/60 hover:text-white";
                    btn.onclick = () => toggleTicket(ticketNum);
                }

                btn.className = classes;
                gridContainer.appendChild(btn);
            }
        }

        // Toggle Ticket Selection
        function toggleTicket(ticketNum) {
            if (selectedTickets.has(ticketNum)) {
                selectedTickets.delete(ticketNum);
            } else {
                selectedTickets.add(ticketNum);
                getOrGenerateExtraNumbers(ticketNum);
            }
            updateUI();
        }

        // Quick Select Random Tickets Machine
        function quickSelect(count) {
            const available = [];
            for (let i = 0; i < TOTAL_TICKETS; i++) {
                const num = String(i).padStart(3, '0');
                if (!takenTickets.has(num) && !selectedTickets.has(num)) {
                    available.push(num);
                }
            }

            available.sort(() => 0.5 - Math.random());
            const toAdd = available.slice(0, count);
            toAdd.forEach(num => {
                selectedTickets.add(num);
                getOrGenerateExtraNumbers(num);
            });

            updateUI();
        }

        // Clear Selected Tickets
        function clearSelection() {
            selectedTickets.clear();
            updateUI();
        }

        // Update All UI Displays
        function updateUI() {
            renderGrid();

            const count = selectedTickets.size;
            const total = count * TICKET_PRICE;

            document.getElementById('selectedCount').textContent = `${count} Boleto(s)`;
            document.getElementById('totalAmount').textContent = `$${total.toLocaleString('es-MX')} MXN`;

            const btnProceed = document.getElementById('btnProceed');
            if (count > 0) {
                btnProceed.disabled = false;
                btnProceed.classList.remove('opacity-50', 'cursor-not-allowed');
            } else {
                btnProceed.disabled = true;
                btnProceed.classList.add('opacity-50', 'cursor-not-allowed');
            }

            const container = document.getElementById('selectedNumbersContainer');
            if (count === 0) {
                container.innerHTML = `<span class="text-gray-500 text-xs italic">Aún no has elegido números. Selecciona en la lista o usa la Máquina de la Suerte.</span>`;
            } else {
                container.innerHTML = '';
                Array.from(selectedTickets).sort().forEach(num => {
                    const extras = getOrGenerateExtraNumbers(num);
                    const card = document.createElement('div');
                    card.className = 'bg-cardBg p-2.5 rounded-xl border border-gray-800 text-xs flex flex-col gap-1';
                    card.innerHTML = `
                        <div class="flex justify-between items-center">
                            <span class="font-extrabold text-white">Boleto Principal: <strong class="text-cashGreen-400 font-mono text-sm">#${num}</strong></span>
                            <button onclick="toggleTicket('${num}')" class="text-red-400 hover:text-red-300 text-[10px] font-bold">
                                <i class="fa-solid fa-xmark"></i> Quitar
                            </button>
                        </div>
                        <div class="text-[11px] text-gold-400 font-medium flex items-center gap-1">
                            <i class="fa-solid fa-gift"></i> Extra de Regalo: <span class="font-mono text-gray-200">#${extras[0]}</span> y <span class="font-mono text-gray-200">#${extras[1]}</span>
                        </div>
                    `;
                    container.appendChild(card);
                });
            }
        }

        // Countdown Timer Logic
        function startCountdown() {
            const targetDate = new Date();
            targetDate.setDate(targetDate.getDate() + 10);

            function updateTimer() {
                const now = new Date().getTime();
                const difference = targetDate - now;

                if (difference > 0) {
                    const days = Math.floor(difference / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                    const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((difference % (1000 * 60)) / 1000);

                    document.getElementById('days').textContent = String(days).padStart(2, '0');
                    document.getElementById('hours').textContent = String(hours).padStart(2, '0');
                    document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
                    document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
                }
            }
            setInterval(updateTimer, 1000);
            updateTimer();
        }

        // Search / Ticket Verification Function
        function searchTicket() {
            let query = document.getElementById('searchInput').value.trim();
            const resultBox = document.getElementById('searchResult');

            if (!query) return;

            query = String(query).padStart(3, '0');
            resultBox.classList.remove('hidden');

            if (takenTickets.has(query)) {
                resultBox.innerHTML = `
                    <div class="flex items-center gap-3 text-red-400">
                        <i class="fa-solid fa-circle-xmark text-2xl"></i>
                        <div>
                            <h4 class="font-bold text-sm text-white">Boleto #${query} - OCUPADO</h4>
                            <p class="text-xs text-gray-400">Este número ya fue apartado por otro participante.</p>
                        </div>
                    </div>
                `;
            } else {
                const extras = getOrGenerateExtraNumbers(query);
                resultBox.innerHTML = `
                    <div class="flex items-center justify-between gap-3 text-cashGreen-400">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-circle-check text-2xl"></i>
                            <div>
                                <h4 class="font-bold text-sm text-white">Boleto #${query} - DISPONIBLE</h4>
                                <p class="text-xs text-gray-300">Incluye extras de regalo: <strong class="text-gold-400 font-mono">#${extras[0]}</strong> y <strong class="text-gold-400 font-mono">#${extras[1]}</strong></p>
                            </div>
                        </div>
                        <button onclick="toggleTicket('${query}')" class="cash-button px-3 py-1.5 rounded-lg text-xs font-extrabold text-white">
                            Elegir
                        </button>
                    </div>
                `;
            }
        }

        // Modal Controls
        function openCheckoutModal() {
            if (selectedTickets.size === 0) return;

            const modalTicketsList = document.getElementById('modalTicketsList');
            modalTicketsList.innerHTML = '';

            Array.from(selectedTickets).sort().forEach(num => {
                const extras = getOrGenerateExtraNumbers(num);
                const item = document.createElement('div');
                item.className = 'flex justify-between border-b border-gray-800 pb-1 last:border-0';
                item.innerHTML = `
                    <span>Principal: <strong class="text-white">#${num}</strong></span>
                    <span class="text-gold-400">Extras: #${extras[0]}, #${extras[1]}</span>
                `;
                modalTicketsList.appendChild(item);
            });

            const total = selectedTickets.size * TICKET_PRICE;
            document.getElementById('modalTicketsCount').textContent = `${selectedTickets.size} boleto(s)`;
            document.getElementById('modalTotal').textContent = `$${total.toLocaleString('es-MX')} MXN`;

            document.getElementById('checkoutModal').classList.remove('hidden');
        }

        function closeCheckoutModal() {
            document.getElementById('checkoutModal').classList.add('hidden');
        }

        // WhatsApp Form Handler
        function handleFormSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('custName').value;
            const phone = document.getElementById('custPhone').value;
            const state = document.getElementById('custState').value;
            const total = selectedTickets.size * TICKET_PRICE;

            let ticketBreakdown = '';
            Array.from(selectedTickets).sort().forEach(num => {
                const extras = getOrGenerateExtraNumbers(num);
                ticketBreakdown += `• Boleto #${num} (Extras de regalo: #${extras[0]} y #${extras[1]})\n`;
            });

            const whatsappMsg = `*¡Hola RFS el Baby! Quiero apartar mis boletos para la Edición #1 de $30,000 Pesos:*\n\n` +
                `👤 *Nombre:* ${name}\n` +
                `📱 *Teléfono:* ${phone}\n` +
                `📍 *Ciudad/Estado:* ${state}\n\n` +
                `🎟️ *BOLETOS Y OPORTUNIDADES:* \n${ticketBreakdown}\n` +
                `💵 *Total a transferir/pagar:* $${total} MXN ($50c/u)\n\n` +
                `Quedo en espera de las cuentas bancarias u OXXO para realizar mi pago.`;

            // Redirect to WhatsApp Business API
            const targetPhone = "5215512345678"; 
            const waUrl = `https://api.whatsapp.com/send?phone=${targetPhone}&text=${encodeURIComponent(whatsappMsg)}`;

            window.open(waUrl, '_blank');
            closeCheckoutModal();
        }
    </script>
